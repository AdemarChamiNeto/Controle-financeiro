# Copie para .env e troque os valores.

# Usados pelo docker-compose
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
MYSQL_PASSWORD=troque-esta-senha

# Rodando fora do Docker (pnpm dev): aponta para o MySQL do compose na porta 3307
DATABASE_URL=mysql://financeiro:troque-esta-senha@localhost:3307/financeiro

# Chave para assinar a sessão (mínimo 32 caracteres). Gere com: openssl rand -hex 32
JWT_SECRET=

# Criptografa o segredo do 2FA no banco: 32 bytes em hex. Gere com: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=
